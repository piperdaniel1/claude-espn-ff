# ---- ESPN account / league -------------------------------------------------
# Copy the two cookies from a browser where you are logged in to fantasy.espn.com
# (see README "Getting your ESPN cookies"). Keep the braces on the SWID.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# The number in the league URL: https://fantasy.espn.com/football/league?leagueId=123456
ESPN_LEAGUE_ID=
# Optional. Your team is detected automatically from the SWID; set this only
# if you own more than one team in the league or detection fails.
ESPN_TEAM_ID=
# Optional. Defaults to the current NFL season.
ESPN_SEASON=

# ---- Connector security -------------------------------------------------------
# The password you type when Claude asks you to sign in to the connector.
CONNECTOR_PASSWORD=
# Random secret (32+ chars) used to sign OAuth codes and tokens.
# Generate one with:  openssl rand -base64 48
CONNECTOR_SECRET=
# Optional. Long random string accepted as a plain bearer token, for local
# testing with MCP Inspector or the scripts in ./scripts. Leave empty in prod
# unless you know you need it.
DEV_BEARER_TOKEN=

# ---- Behaviour -----------------------------------------------------------------
# IANA timezone used for all dates/times shown to Claude.
TIMEZONE=America/Denver
# Optional. Only needed when the site is served from a custom domain that
# differs from the request URL (rare). Example: https://ff.example.com
PUBLIC_URL=
